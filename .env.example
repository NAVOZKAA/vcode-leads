# Keep this file private. Never put secrets in the browser.
INSTANTLY_API_KEY=replace_me

# Security: One-time activation key required to access the dashboard
APP_ACTIVATION_KEY=vcode_secure_key_2026

# Email Notifications for "Interested" leads (SMTP settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="VCode Alerts <your_email@gmail.com>"

# Optional: require the webhook URL to include ?secret=this-value
WEBHOOK_SECRET=replace_me

# The public URL of this dashboard, for example https://leads.vcode.ma
PUBLIC_URL=http://localhost:3000
